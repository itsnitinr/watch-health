# Copy to .env.local and fill in.

# Anthropic API key for the "Ask" agent (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Shared secret the Android app sends with each upload. Generate one with:
#   openssl rand -hex 24
INGEST_TOKEN=

# Optional: where the SQLite database lives (default: ../data/health.db)
# HEALTH_DB_PATH=

# Optional: your max heart rate, for heart-rate zones and training load
# (default: highest heart rate recorded in a workout)
# MAX_HR=190

# Optional: daily goals for the rings on the Today page
# STEPS_GOAL=10000
# SLEEP_GOAL_HOURS=8
# EXERCISE_GOAL_MIN=30
